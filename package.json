{
  "name": "grclanker",
  "type": "module",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-links.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:site": "node --test \"scripts/*.test.mjs\"",
    "preview": "npm run build && wrangler dev",
    "sync:fedramp": "npm --prefix cli run sync:fedramp",
    "sync:tool-catalog": "npm --prefix cli run sync:tool-catalog",
    "generate-types": "wrangler types",
    "check": "next typegen && tsc --noEmit",
    "prebuild": "npm run check",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-smartypants": "^3.0.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
