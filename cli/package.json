{
  "name": "@grclanker/cli",
  "version": "0.0.1",
  "type": "module",
  "description": "Experimental local-first GRC CLI for CMVP, KEV, EPSS, and framework-mapped posture work",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackIDLE/grclanker.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "grclanker": "./bin/grclanker.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && npm run brand:embedded-pi",
    "dev": "tsx index.ts",
    "start": "node dist/index.js",
    "flue:run": "node dist/flue/cli.js run",
    "sync:fedramp": "tsx scripts/sync-fedramp.ts",
    "sync:tool-catalog": "npm run build && node scripts/generate-tool-catalog-docs.mjs",
    "sync:agent-sdk-tools": "npm run build && node scripts/generate-agent-sdk-tools.mjs",
    "agent-sdk:validate": "agent-sdk validate --dir agent-sdk",
    "agent-sdk:info": "agent-sdk info --dir agent-sdk",
    "agent-sdk:dev": "agent-sdk dev agent-sdk --mode single",
    "agent-sdk:run": "agent-sdk run --dir agent-sdk",
    "agent-sdk:call": "agent-sdk call --dir agent-sdk",
    "postinstall": "node scripts/patch-embedded-pi.mjs --root .",
    "brand:embedded-pi": "node scripts/patch-embedded-pi.mjs",
    "build:bundle": "node scripts/build-native-bundle.mjs",
    "prepack": "npm run build",
    "test:cli": "npm run build && node --test \"tests/*.test.mjs\"",
    "test:agent-sdk:validate": "npm run build && node scripts/agent-sdk-validate-smoke.mjs",
    "test:ansible:live": "npm run build && node scripts/ansible-live-smoke.mjs",
    "test:aws:live": "npm run build && node scripts/aws-live-smoke.mjs",
    "test:azure:live": "npm run build && node scripts/azure-live-smoke.mjs",
    "test:box:live": "npm run build && node scripts/box-live-smoke.mjs",
    "test:cloudflare:live": "npm run build && node scripts/cloudflare-live-smoke.mjs",
    "test:crowdstrike:live": "npm run build && node scripts/crowdstrike-live-smoke.mjs",
    "test:datadog:live": "npm run build && node scripts/datadog-live-smoke.mjs",
    "test:duo:live": "npm run build && node scripts/duo-live-smoke.mjs",
    "test:elastic:live": "npm run build && node scripts/elastic-live-smoke.mjs",
    "test:github:live": "npm run build && node scripts/github-live-smoke.mjs",
    "test:gws-ops:live": "npm run build && node scripts/gws-ops-live-smoke.mjs",
    "test:gws:live": "npm run build && node scripts/gws-live-smoke.mjs",
    "test:knowbe4:live": "npm run build && node scripts/knowbe4-live-smoke.mjs",
    "test:launchdarkly:live": "npm run build && node scripts/launchdarkly-live-smoke.mjs",
    "test:mulesoft:live": "npm run build && node scripts/mulesoft-live-smoke.mjs",
    "test:okta:live": "npm run build && node scripts/okta-live-smoke.mjs",
    "test:oscal:live": "npm run build && node scripts/oscal-live-smoke.mjs",
    "test:pagerduty:live": "npm run build && node scripts/pagerduty-live-smoke.mjs",
    "test:paloalto:live": "npm run build && node scripts/paloalto-live-smoke.mjs",
    "test:salesforce:live": "npm run build && node scripts/salesforce-live-smoke.mjs",
    "test:servicenow:live": "npm run build && node scripts/servicenow-live-smoke.mjs",
    "test:snowflake:live": "npm run build && node scripts/snowflake-live-smoke.mjs",
    "test:splunk:live": "npm run build && node scripts/splunk-live-smoke.mjs",
    "test:sumologic:live": "npm run build && node scripts/sumologic-live-smoke.mjs",
    "test:tenable:live": "npm run build && node scripts/tenable-live-smoke.mjs",
    "test:vanta:live": "npm run build && node scripts/vanta-live-smoke.mjs",
    "test:veracode:live": "npm run build && node scripts/veracode-live-smoke.mjs",
    "test:zendesk:live": "npm run build && node scripts/zendesk-live-smoke.mjs",
    "test:webex:live": "npm run build && node scripts/webex-live-smoke.mjs",
    "test:isolation": "npm run build && node --test tests/isolation.test.mjs"
  },
  "files": [
    "bin",
    "dist",
    "extensions",
    "flue",
    "prompts",
    "scripts",
    "skills",
    ".grclanker"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.61",
    "@aws-sdk/client-accessanalyzer": "^3.1075.0",
    "@aws-sdk/client-account": "^3.1075.0",
    "@aws-sdk/client-auditmanager": "^3.1075.0",
    "@aws-sdk/client-cloudtrail": "^3.1075.0",
    "@aws-sdk/client-config-service": "^3.1075.0",
    "@aws-sdk/client-ec2": "^3.1075.0",
    "@aws-sdk/client-guardduty": "^3.1075.0",
    "@aws-sdk/client-iam": "^3.1075.0",
    "@aws-sdk/client-kms": "^3.1075.0",
    "@aws-sdk/client-organizations": "^3.1075.0",
    "@aws-sdk/client-rds": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-s3-control": "^3.1075.0",
    "@aws-sdk/client-securityhub": "^3.1075.0",
    "@aws-sdk/client-sso-admin": "^3.1075.0",
    "@aws-sdk/client-sts": "^3.1075.0",
    "@aws-sdk/credential-providers": "^3.1075.0",
    "@clack/prompts": "^1.6.0",
    "@earendil-works/pi-ai": "^0.80.2",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@flue/runtime": "^2.1.0",
    "@sinclair/typebox": "^0.34.48",
    "archiver": "^8.0.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cursor/july": "0.2.1",
    "@flue/cli": "^2.1.0",
    "@types/archiver": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "basic-ftp": "6.0.1",
    "undici": "7.28.0",
    "protobufjs": "7.6.4"
  }
}
