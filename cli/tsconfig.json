{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["*.ts", "pi/**/*", "extensions/**/*", "bootstrap/**/*", "config/**/*", "core/**/*", "adapters/openai-agents/**/*", "adapters/claude-api/**/*", "adapters/cursor-grok/**/*", "flue/**/*", "durable/**/*"],
  "exclude": ["node_modules", "dist"]
}
